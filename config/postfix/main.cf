# =============================================================================
# Mail Platform :: /etc/postfix/main.cf (gerado por deploy-mail-node.sh)
# Postfix 3.x (Debian 13). Domínios/contas virtuais vêm do PostgreSQL
# (Servidor 2, TLS verify-full) e toda entrega local vai para o pipe
# criptográfico mail-ingest.py — nada é persistido em Maildir.
# =============================================================================
compatibility_level = 3.6

# ---- Identidade --------------------------------------------------------------
myhostname = {{MAIL_HOSTNAME}}
mydomain = {{MAIL_DOMAIN}}
myorigin = $myhostname
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8 [::1]/128
inet_interfaces = all
inet_protocols = {{INET_PROTOCOLS}}
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
recipient_delimiter = +

# ---- Tabelas locais (LMDB; Berkeley DB está obsoleto) ------------------------
default_database_type = lmdb
alias_maps = lmdb:/etc/aliases
alias_database = lmdb:/etc/aliases

# ---- Log em arquivo (consumido pelo Fail2ban; Debian 13 não traz rsyslog) ---
maillog_file = /var/log/postfix.log

# ---- Limites -----------------------------------------------------------------
message_size_limit = 52428800
mailbox_size_limit = 0
smtpd_recipient_limit = 100
smtpd_client_connection_count_limit = 20
smtpd_client_connection_rate_limit = 60
smtpd_client_message_rate_limit = 120
anvil_rate_time_unit = 60s
smtpd_error_sleep_time = 1s
smtpd_soft_error_limit = 5
smtpd_hard_error_limit = 10
smtpd_timeout = 60s
disable_vrfy_command = yes
strict_rfc821_envelopes = yes
smtpd_helo_required = yes
smtpd_delay_reject = yes
delay_warning_time = 4h
maximal_queue_lifetime = 3d
bounce_queue_lifetime = 1d

# ---- TLS de entrada (smtpd) --------------------------------------------------
smtpd_tls_cert_file = {{TLS_CERT}}
smtpd_tls_key_file = {{TLS_KEY}}
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high
smtpd_tls_exclude_ciphers = aNULL, eNULL, MD5, RC4, 3DES, DES
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
tls_preempt_cipherlist = no

# ---- TLS de saída (smtp) -----------------------------------------------------
smtp_tls_security_level = may
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
smtp_tls_note_starttls_offer = yes

# ---- Domínios e contas virtuais no PostgreSQL (Servidor 2) -------------------
# proxy: centraliza as conexões no proxymap (fora do chroot, reaproveita TLS).
virtual_mailbox_domains = proxy:pgsql:/etc/postfix/pgsql/virtual_domains.cf
virtual_mailbox_maps = proxy:pgsql:/etc/postfix/pgsql/virtual_mailboxes.cf
virtual_alias_maps =
virtual_transport = mailingest
# Um destinatário por execução do pipe: cada mensagem é selada com a
# public_key exclusiva daquele destinatário.
mailingest_destination_recipient_limit = 1
mailingest_destination_concurrency_limit = 10

# libpq (postfix-pgsql) herda estas variáveis: TLS obrigatório com validação
# completa do certificado do Servidor 2 contra a CA privada da plataforma.
import_environment = {{IMPORT_ENVIRONMENT}} PGSSLMODE=verify-full PGSSLROOTCERT={{DB_CA_FILE}} PGCONNECT_TIMEOUT=5 PGAPPNAME=postfix

# ---- Restrições SMTP ---------------------------------------------------------
smtpd_client_restrictions =
    permit_mynetworks,
    reject_unauth_pipelining
smtpd_helo_restrictions =
    permit_mynetworks,
    reject_invalid_helo_hostname,
    reject_non_fqdn_helo_hostname
smtpd_sender_restrictions =
    permit_mynetworks,
    reject_non_fqdn_sender,
    reject_unknown_sender_domain
smtpd_relay_restrictions =
    permit_mynetworks,
    reject_unauth_destination
smtpd_recipient_restrictions =
    permit_mynetworks,
    reject_non_fqdn_recipient,
    reject_unknown_recipient_domain,
    reject_unlisted_recipient,
    {{RBL_RESTRICTIONS}}
    permit
smtpd_data_restrictions =
    reject_unauth_pipelining,
    reject_multi_recipient_bounce

# ---- Milters -----------------------------------------------------------------
# Porta 25: Rspamd (antispam + verificação SPF/DKIM/DMARC -> Authentication-Results).
# Mensagens geradas localmente (bounces, cron): assinatura OpenDKIM.
# A submission (127.0.0.1:587, master.cf) usa somente OpenDKIM para assinar.
milter_protocol = 6
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
smtpd_milters = inet:127.0.0.1:11332
non_smtpd_milters = inet:127.0.0.1:8891

# ---- Diversos ----------------------------------------------------------------
smtputf8_enable = yes
notify_classes = resource, software
2bounce_notice_recipient = postmaster
