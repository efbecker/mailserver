# Mail Platform :: contas virtuais ativas (gerado por deploy-mail-node.sh)
# O valor retornado é irrelevante para o transporte (pipe); serve para
# reject_unlisted_recipient recusar destinatários inexistentes já no RCPT TO.
hosts = inet:{{DB_HOST}}:{{DB_PORT}}
user = {{DB_POSTFIX_USER}}
password = {{DB_POSTFIX_PASSWORD}}
dbname = {{DB_NAME}}
query = SELECT a.email FROM mail_accounts a JOIN mail_domains d ON d.id = a.domain_id WHERE lower(a.email) = lower('%s') AND a.active = TRUE AND d.active = TRUE LIMIT 1
